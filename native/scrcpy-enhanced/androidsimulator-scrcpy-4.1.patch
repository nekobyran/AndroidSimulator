+
+static uint32_t
+sc_screen_read_env_u32(const char *name, uint32_t default_value,
+                       uint32_t min_value, uint32_t max_value) {
+    const char *value = getenv(name);
+    if (!value || !*value) {
+        return default_value;
+    }
+
+    char *end = NULL;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (!end || *end || parsed < min_value || parsed > max_value) {
+        LOGW("Ignore invalid %s=%s", name, value);
+        return default_value;
+    }
+
+    return (uint32_t) parsed;
+}
+
+static struct sc_size
+sc_screen_supersample_size(struct sc_screen *screen, struct sc_size logical) {
+    uint32_t percent = screen->supersampling_percent;
+    if (percent <= 100) {
+        return logical;
+    }
+
+    uint32_t width = ((uint32_t) logical.width * percent + 50) / 100;
+    uint32_t height = ((uint32_t) logical.height * percent + 50) / 100;
+    uint32_t longest = MAX(width, height);
+    if (longest > SC_ANDROID_SIMULATOR_MAX_SUPERSAMPLED_DIMENSION) {
+        width = width * SC_ANDROID_SIMULATOR_MAX_SUPERSAMPLED_DIMENSION / longest;
+        height = height * SC_ANDROID_SIMULATOR_MAX_SUPERSAMPLED_DIMENSION / longest;
+    }
+
+    width = MAX(2, width & ~1u);
+    height = MAX(2, height & ~1u);
+    return (struct sc_size) {(uint16_t) width, (uint16_t) height};
+}
+
+static struct sc_size
+sc_screen_logical_size(struct sc_screen *screen, struct sc_size sampled) {
+    uint32_t percent = screen->supersampling_percent;
+    if (screen->supersampling_last_sampled.width == sampled.width
+            && screen->supersampling_last_sampled.height == sampled.height
+            && screen->supersampling_last_logical.width
+            && screen->supersampling_last_logical.height) {
+        return screen->supersampling_last_logical;
+    }
+    if (percent <= 100) {
+        return sampled;
+    }
+
+    uint32_t width = MAX(2, ((uint32_t) sampled.width * 100 + percent / 2) / percent);
+    uint32_t height = MAX(2, ((uint32_t) sampled.height * 100 + percent / 2) / percent);
+    return (struct sc_size) {(uint16_t) width, (uint16_t) height};
+}
