+static bool
+sc_screen_render_texture(struct sc_screen *screen, SDL_Texture *texture,
+                         const SDL_FRect *geometry, float alpha) {
+    SDL_Renderer *renderer = screen->renderer;
+    bool blending = alpha < .999f;
+    if (!SDL_SetTextureBlendMode(texture,
+                                 blending ? SDL_BLENDMODE_BLEND
+                                          : SDL_BLENDMODE_NONE)) {
+        LOGE("Could not set texture blend mode: %s", SDL_GetError());
+        return false;
+    }
+    if (!SDL_SetTextureAlphaModFloat(texture, alpha)) {
+        LOGE("Could not set texture alpha: %s", SDL_GetError());
+        return false;
+    }
+
+    SDL_FRect target = *geometry;
+    enum sc_orientation orientation = screen->orientation;
+    bool ok;
+    if (orientation == SC_ORIENTATION_0) {
+        target.x = (int32_t) target.x;
+        target.y = (int32_t) target.y;
+        ok = SDL_RenderTexture(renderer, texture, NULL, &target);
+    } else {
+        unsigned cw_rotation = sc_orientation_get_rotation(orientation);
+        double angle = 90 * cw_rotation;
+        SDL_FRect rect;
+        SDL_FRect *dstrect;
+        if (sc_orientation_is_swap(orientation)) {
+            rect.x = target.x + (target.w - target.h) / 2.f;
+            rect.y = target.y + (target.h - target.w) / 2.f;
+            rect.w = target.h;
+            rect.h = target.w;
+            dstrect = &rect;
+        } else {
+            dstrect = &target;
+        }
+
+        SDL_FlipMode flip = sc_orientation_is_mirror(orientation)
+                              ? SDL_FLIP_HORIZONTAL : 0;
+        dstrect->x = (int32_t) dstrect->x;
+        dstrect->y = (int32_t) dstrect->y;
+        ok = SDL_RenderTextureRotated(renderer, texture, NULL, dstrect, angle,
+                                      NULL, flip);
+    }
+
+    if (!ok) {
+        LOGE("Could not render texture: %s", SDL_GetError());
+    }
+    return ok;
+}
