<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AndroidSimulator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AndroidSimulator.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#FFFFB74D</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFFFCC80</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFFFE0B2</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFFFF3E0</Color>
                    <Color x:Key="SystemAccentColorDark1">#FFFF9800</Color>
                    <Color x:Key="SystemAccentColorDark2">#FFF57C00</Color>
                    <Color x:Key="SystemAccentColorDark3">#FFE65100</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FFB74D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFFB74D" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6FFB74D" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CCFFB74D" />
                    <SolidColorBrush x:Key="MaterialOrangeFillBrush" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="MaterialOrangeSubtleBrush" Color="#33FFB74D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FFFF9800</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFFFB74D</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFFFCC80</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFFFE0B2</Color>
                    <Color x:Key="SystemAccentColorDark1">#FFF57C00</Color>
                    <Color x:Key="SystemAccentColorDark2">#FFE65100</Color>
                    <Color x:Key="SystemAccentColorDark3">#FFBF360C</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF9800" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF9800" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF9800" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFE65100" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6E65100" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CCE65100" />
                    <SolidColorBrush x:Key="MaterialOrangeFillBrush" Color="#FFFF9800" />
                    <SolidColorBrush x:Key="MaterialOrangeSubtleBrush" Color="#22FF9800" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="MaterialOrangeFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MaterialOrangeSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="AppBodyFontFamily">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display</FontFamily>

            <Style x:Key="AppPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppPageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="AppInlineCodeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AppListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="AppListIconHostStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource MaterialOrangeSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="AppGroupedSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
