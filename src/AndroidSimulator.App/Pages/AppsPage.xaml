<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AndroidSimulator.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid
        x:Name="PageRoot"
        Padding="32,28,32,40"
        RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16,20,16,28" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="32,28,32,40" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Right" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing
                x:Name="OperationProgressRing"
                Grid.Column="0"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                AutomationProperties.Name="应用操作进行中"
                IsActive="False"
                Visibility="Collapsed" />
            <Button
                x:Name="ImportButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="导入 APK"
                Click="ImportButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE898;" />
                    <TextBlock Text="导入 APK" />
                </StackPanel>
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="刷新应用列表"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.Name="打开设置"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" />
            </Button>
        </Grid>

            <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            IsClosable="True"
            IsOpen="False" />

        <Grid
            Grid.Row="2"
            Margin="0,0,0,72"
            HorizontalAlignment="Stretch">
            <ScrollViewer
                x:Name="AppsList"
                AutomationProperties.Name="已安装的用户应用"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <ItemsRepeater
                    x:Name="AppsRepeater"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="4"
                            MinItemHeight="112"
                            MinItemWidth="116"
                            MinRowSpacing="4"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                MinHeight="104"
                                Padding="8"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="{Binding Name}"
                                Click="LaunchAppButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="{Binding PackageName}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem
                                            DataContext="{Binding}"
                                            Click="LaunchAppButton_Click"
                                            Text="打开">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            DataContext="{Binding}"
                                            Click="CreateShortcutButton_Click"
                                            Text="创建桌面快捷方式">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE718;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            DataContext="{Binding}"
                                            Click="RenameAppMenuItem_Click"
                                            Text="重命名">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            DataContext="{Binding}"
                                            Click="UninstallAppMenuItem_Click"
                                            Text="卸载">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="6">
                                    <Border
                                        Width="56"
                                        Height="56"
                                        HorizontalAlignment="Center"
                                        CornerRadius="12">
                                        <Grid>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="24"
                                                Glyph="&#xE71D;"
                                                Visibility="{Binding FallbackIconVisibility}" />
                                            <Image
                                                Width="56"
                                                Height="56"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding IconImage}"
                                                Stretch="UniformToFill"
                                                Visibility="{Binding IconVisibility}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        MaxWidth="100"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在读取已安装应用…" />
                <TextBlock
                    x:Name="OperationStatusText"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="导入、启动与快捷方式操作会在完成后刷新此列表。"
                    TextAlignment="Center" />
            </StackPanel>

            <StackPanel
                x:Name="EmptyPanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Glyph="&#xE71D;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="还没有可用应用" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="导入 APK 后，它会显示在这里。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="ImportButton_Click"
                    Content="导入 APK" />
            </StackPanel>

            <StackPanel
                x:Name="ErrorPanel"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Glyph="&#xEA39;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="无法读取应用列表" />
                <TextBlock
                    x:Name="ErrorMessageText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="RefreshButton_Click"
                    Content="重试" />
            </StackPanel>
        </Grid>

        <Button
            x:Name="RuntimeButton"
            Grid.Row="2"
            Width="56"
            Height="56"
            MinWidth="56"
            MinHeight="56"
            Padding="0"
            Margin="0,0,4,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="启动后台 Android"
            Click="RuntimeButton_Click"
            CornerRadius="28"
            Style="{StaticResource AccentButtonStyle}"
            ToolTipService.ToolTip="启动后台 Android">
            <Grid>
                <FontIcon
                    x:Name="RuntimeStateIcon"
                    FontSize="20"
                    Glyph="&#xE768;" />
                <ProgressRing
                    x:Name="RuntimeProgressRing"
                    Width="22"
                    Height="22"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
        </Button>

        <ContentDialog
            x:Name="ImageDownloadDialog"
            CloseButtonText="稍后"
            DefaultButton="Primary"
            PrimaryButtonText="一键下载并准备"
            Title="需要下载 Android 系统镜像">
            <StackPanel Width="420" Spacing="12">
                <TextBlock
                    Text="未检测到已校验的 BlissOS 系统镜像。可一键下载并准备运行时（约 2 GB ISO，含校验与启动文件），或先打开官方镜像站确认文件。"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Content="打开 BlissOS 官方镜像站"
                    NavigateUri="https://sourceforge.net/projects/blissos-x86/files/Official/BlissOS16/FOSS/Generic/" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="镜像：BlissOS 16.9.7 FOSS · 固定 SHA-256 校验 · 同时准备 scrcpy 与 kernel/initrd"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
