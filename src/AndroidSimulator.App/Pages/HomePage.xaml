<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AndroidSimulator.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PageStack"
            MaxWidth="1120"
            Padding="32,28,32,40"
            HorizontalAlignment="Stretch"
            Spacing="24">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Padding" Value="16,20,16,28" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="980" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Padding" Value="32,28,32,40" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="概览" />
                    <TextBlock
                        Style="{StaticResource AppPageSubtitleStyle}"
                        Text="完整 Android 在后台运行；应用分别显示为可并存的 Windows 独立窗口。" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="刷新运行状态"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <Border
                Padding="24"
                Style="{StaticResource AppGroupedSurfaceStyle}">
                <Grid ColumnSpacing="32" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                x:Name="ControlStatusIcon"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE9CE;" />
                            <TextBlock
                                x:Name="ControlStatusText"
                                FontFamily="{StaticResource AppDisplayFontFamily}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="正在检查控制组件" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ControlStatusDetail"
                            MaxWidth="680"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="请稍候…"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        x:Name="StartRuntimeButton"
                        Grid.Column="1"
                        MinWidth="144"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="启动后台 Android"
                        Click="StartRuntimeButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                x:Name="StartRuntimeProgressRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <FontIcon Glyph="&#xE768;" />
                            <TextBlock x:Name="StartRuntimeButtonLabel" Text="启动后台 Android" />
                        </StackPanel>
                    </Button>

                    <StackPanel
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="28">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="后台状态" />
                            <TextBlock
                                x:Name="InstalledAppsText"
                                FontFamily="{StaticResource AppDisplayFontFamily}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="窗口材质" />
                            <TextBlock
                                x:Name="BackdropText"
                                FontFamily="{StaticResource AppDisplayFontFamily}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="系统自适应" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="快速入口" />
                <Border
                    Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Button
                            MinHeight="64"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="打开应用库"
                            Click="OpenAppsButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE71D;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="应用库" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="安装 APK、打开独立应用窗口并创建桌面快捷方式" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                            </Grid>
                        </Button>
                        <Rectangle
                            Height="1"
                            Margin="48,0,12,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            MinHeight="64"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="打开键位映射"
                            Click="OpenKeyMappingsButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE765;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="键位映射" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="只向当前前台应用窗口的虚拟显示发送自定义操作" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

        <ContentDialog
            x:Name="ImageDownloadDialog"
            CloseButtonText="稍后"
            DefaultButton="Primary"
            PrimaryButtonText="一键下载并准备"
            Title="需要下载 Android 系统镜像">
            <StackPanel Width="420" Spacing="12">
                <TextBlock
                    Text="未检测到已校验的 BlissOS 系统镜像。可一键下载并准备运行时（约 2 GB ISO，含校验与启动文件），或先打开官方镜像站确认文件。"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Content="打开 BlissOS 官方镜像站"
                    NavigateUri="https://sourceforge.net/projects/blissos-x86/files/Official/BlissOS16/FOSS/Generic/" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="镜像：BlissOS 16.9.7 FOSS · 固定 SHA-256 校验 · 同时准备 scrcpy 与 kernel/initrd"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
