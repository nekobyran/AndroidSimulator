<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AndroidSimulator.App.Pages.KeyMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid
        x:Name="PageRoot"
        Padding="32,28,32,40"
        RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16,20,16,28" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="32,28,32,40" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="1120" HorizontalAlignment="Stretch" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Width="40"
                Height="40"
                MinWidth="40"
                MinHeight="40"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="返回设置"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回设置">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="键位" />
                <TextBlock
                    Style="{StaticResource AppPageSubtitleStyle}"
                    Text="为独立应用窗口追加自定义键位；普通键鼠仍由窗口原生转发。" />
            </StackPanel>
            <ProgressRing
                x:Name="OperationProgressRing"
                Grid.Column="2"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                AutomationProperties.Name="键位操作进行中"
                IsActive="False"
                Visibility="Collapsed" />
            <Button
                x:Name="AddMappingButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.Name="添加键位映射"
                Click="AddMappingButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock Text="添加键位" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            MaxWidth="1120"
            HorizontalAlignment="Stretch"
            IsClosable="True"
            IsOpen="False" />

        <Grid
            Grid.Row="2"
            MaxWidth="1120"
            HorizontalAlignment="Stretch">
            <ListView
                x:Name="MappingsList"
                AutomationProperties.Name="键位映射列表"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource AppListViewItemStyle}"
                SelectionMode="None">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            MinHeight="72"
                            Padding="8,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="启用此键位"
                                    IsOn="{Binding IsEnabled, Mode=OneWay}"
                                    Toggled="MappingToggle_Toggled"
                                    ToolTipService.ToolTip="启用或停用" />

                                <Border
                                    Grid.Column="1"
                                    MinWidth="72"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource MaterialOrangeSubtleBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorTertiaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontWeight="SemiBold"
                                        Text="{Binding HostKeyText}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ActionSummary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="删除键位映射"
                                    Click="DeleteMappingButton_Click"
                                    ToolTipService.ToolTip="删除">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在读取键位…" />
            </StackPanel>

            <StackPanel
                x:Name="EmptyPanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Glyph="&#xE765;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="还没有键位映射" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="添加后，映射只会发送到当前前台独立窗口对应的虚拟显示。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="AddMappingButton_Click"
                    Content="添加键位" />
            </StackPanel>

            <StackPanel
                x:Name="ErrorPanel"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Glyph="&#xEA39;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="无法读取键位" />
                <TextBlock
                    x:Name="ErrorMessageText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="RetryButton_Click"
                    Content="重试" />
            </StackPanel>
        </Grid>

        <ContentDialog
            x:Name="AddMappingDialog"
            Grid.RowSpan="3"
            CloseButtonText="取消"
            DefaultButton="Primary"
            Opened="AddMappingDialog_Opened"
            PrimaryButtonClick="AddMappingDialog_PrimaryButtonClick"
            PrimaryButtonText="添加"
            Title="添加键位映射">
            <StackPanel Width="420" Spacing="14">
                <TextBox
                    x:Name="MappingNameBox"
                    Header="名称（可选）"
                    MaxLength="64"
                    PlaceholderText="例如：普通攻击" />
                <TextBox
                    x:Name="HostKeyBox"
                    AutomationProperties.HelpText="聚焦此输入框后按下要绑定的键"
                    Header="宿主键"
                    IsReadOnly="True"
                    KeyDown="HostKeyBox_KeyDown"
                    PlaceholderText="单击后按键"
                    ToolTipService.ToolTip="单击输入框，然后按下一个键" />
                <ComboBox
                    x:Name="ActionTypeBox"
                    Header="Android 操作"
                    SelectionChanged="ActionTypeBox_SelectionChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="点击坐标" Tag="tap" />
                    <ComboBoxItem Content="Android 按键" Tag="key-event" />
                </ComboBox>
                <Grid x:Name="TapFields" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="TapXBox"
                        Header="X 坐标"
                        Maximum="65535"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="TapYBox"
                        Grid.Column="1"
                        Header="Y 坐标"
                        Maximum="65535"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
                <TextBox
                    x:Name="AndroidKeyCodeBox"
                    Header="Android keyevent"
                    MaxLength="48"
                    PlaceholderText="例如 KEYCODE_BACK 或 4"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="DialogValidationText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
