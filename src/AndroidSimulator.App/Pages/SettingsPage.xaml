<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AndroidSimulator.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PageStack"
            MaxWidth="1120"
            Padding="32,28,32,40"
            HorizontalAlignment="Stretch"
            Spacing="28">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Padding" Value="16,20,16,28" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="980" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageStack.Padding" Value="32,28,32,40" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="40"
                    Height="40"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="返回应用库"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回应用库">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="设置" />
                    <TextBlock
                        Style="{StaticResource AppPageSubtitleStyle}"
                        Text="调整启动器、键位与后台 Android 组件。" />
                </StackPanel>
                        </Grid>

            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="性能" />
                    <TextBlock
                        x:Name="PerformanceSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在读取…" />
                </Grid>
                <Border Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="性能模式" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="节能 / 均衡 / 性能会直接调整 QEMU vCPU、内存与 Windows 调度优先级。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="PerformanceModeComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="RuntimeSettingsControl_Changed">
                                <ComboBoxItem Content="节能 · 2 核 / 3 GB" Tag="eco" />
                                <ComboBoxItem Content="均衡 · 4 核 / 6 GB" Tag="balanced" />
                                <ComboBoxItem Content="性能 · 6 核 / 8 GB" Tag="performance" />
                                <ComboBoxItem Content="自定义" Tag="custom" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="自定义资源" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="仅在“自定义”性能模式使用；保存后会重写 QEMU profile，下次冷启动生效。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox
                                x:Name="CpuCoresNumberBox"
                                Grid.Column="1"
                                Header="CPU 核心"
                                Minimum="2"
                                Maximum="12"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline" />
                            <NumberBox
                                x:Name="MemoryMbNumberBox"
                                Grid.Column="2"
                                Header="内存 MB"
                                Minimum="3072"
                                Maximum="16384"
                                SmallChange="1024"
                                SpinButtonPlacementMode="Inline" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="显示与帧率" />
                <Border Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="渲染器" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Direct3D 兼容优先；OpenGL 可使用 mipmap 高质量缩放。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="RendererModeComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="RuntimeSettingsControl_Changed">
                                <ComboBoxItem Content="Direct3D" Tag="direct3d" />
                                <ComboBoxItem Content="OpenGL" Tag="opengl" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="画质策略" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="真实改变 scrcpy 编码上限与视频码率。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="GraphicsStrategyComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="RuntimeSettingsControl_Changed">
                                <ComboBoxItem Content="效率 · 4 Mbps" Tag="efficiency" />
                                <ComboBoxItem Content="均衡 · 8 Mbps" Tag="balanced" />
                                <ComboBoxItem Content="画质 · 16 Mbps" Tag="quality" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Android 分辨率" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="自适应模式跟随 Windows DPI；拖动窗口时由 scrcpy --flex-display 实时改变虚拟显示。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ResolutionModeComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="RuntimeSettingsControl_Changed">
                                <ComboBoxItem Content="自适应" Tag="adaptive" />
                                <ComboBoxItem Content="1280 × 720" Tag="p720" />
                                <ComboBoxItem Content="1920 × 1080" Tag="p1080" />
                                <ComboBoxItem Content="2560 × 1440" Tag="p1440" />
                                <ComboBoxItem Content="自定义" Tag="custom" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="86" Padding="16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="自定义分辨率" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="宽度、高度与 Android DPI。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox x:Name="CustomWidthNumberBox" Grid.Column="1" Header="宽" Minimum="640" Maximum="3840" SpinButtonPlacementMode="Inline" />
                            <NumberBox x:Name="CustomHeightNumberBox" Grid.Column="2" Header="高" Minimum="360" Maximum="2160" SpinButtonPlacementMode="Inline" />
                            <NumberBox x:Name="CustomDpiNumberBox" Grid.Column="3" Header="DPI" Minimum="120" Maximum="640" SpinButtonPlacementMode="Inline" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="最高帧率" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Android 捕获上限 60 FPS；高于 60 时由内置时域插帧器生成真实中间帧。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox
                                x:Name="MaxFrameRateNumberBox"
                                Grid.Column="1"
                                Minimum="30"
                                Maximum="240"
                                SmallChange="30"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="RuntimeSettingsNumberBox_ValueChanged" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="超分辨率" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="提高 Android 虚拟显示像素与 DPI，再高质量缩回窗口；保持 dp 布局大小不变。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SuperResolutionToggle"
                                Grid.Column="1"
                                OffContent="关闭"
                                OnContent="开启"
                                Toggled="RuntimeSettingsToggle_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="超分倍率" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="100–200%，采样最长边限制为 3840。" />
                            </StackPanel>
                            <NumberBox
                                x:Name="SuperResolutionScaleNumberBox"
                                Grid.Column="1"
                                Minimum="100"
                                Maximum="200"
                                SmallChange="25"
                                SpinButtonPlacementMode="Inline" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="帧插值" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="保留前后真实解码帧，按源帧时间间隔混合生成中间帧；目标帧率需高于 60。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="FrameInterpolationToggle"
                                Grid.Column="1"
                                OffContent="关闭"
                                OnContent="开启"
                                Toggled="RuntimeSettingsToggle_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="垂直同步" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="直接调用 SDL renderer VSync，变更后重建应用窗口。" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="VerticalSyncToggle"
                                Grid.Column="1"
                                OffContent="关闭"
                                OnContent="开启"
                                Toggled="RuntimeSettingsToggle_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="固定窗口尺寸" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="关闭时使用 --flex-display 实时缩放；开启时维持启动分辨率。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="FixedWindowSizeToggle"
                                Grid.Column="1"
                                OffContent="实时缩放"
                                OnContent="固定"
                                Toggled="RuntimeSettingsToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="应用与启动" />
                <Border Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Android 主显示音频" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="只对 Android() 主显示镜像启用音频；独立应用窗口仍保持无音频，避免多窗口重复声道。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SystemAudioToggle"
                                Grid.Column="1"
                                OffContent="静音"
                                OnContent="启用" />
                        </Grid>
                        <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="84" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="一键准备并启动 Android" />
                                <TextBlock
                                    x:Name="BootstrapRuntimeStateText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="下载/复用系统与工具链 → Provision → QEMU → 等待 ADB boot_completed。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="BootstrapProgressRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                                <Button x:Name="BootstrapRuntimeButton" Click="BootstrapRuntimeButton_Click" Content="准备并启动" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <InfoBar
                        x:Name="RuntimeSettingsInfoBar"
                        Grid.Column="0"
                        IsClosable="True"
                        IsOpen="False" />
                    <Button
                        x:Name="ResetRuntimeSettingsButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="ResetRuntimeSettingsButton_Click"
                        Content="恢复默认" />
                    <Button
                        x:Name="SaveRuntimeSettingsButton"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Click="SaveRuntimeSettingsButton_Click"
                        Content="保存设置"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="输入" />
                <Border Style="{StaticResource AppGroupedSurfaceStyle}">
                    <Button
                        MinHeight="72"
                        Padding="16,10"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="配置键位映射"
                        Click="OpenKeyMappingsButton_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                Glyph="&#xE765;" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="键位映射" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="像 GameLauncher 的输入设置一样集中管理按键；映射只发送到当前可信的独立应用窗口。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="外观" />
                <Border
                    Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Grid MinHeight="72" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="应用主题" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="跟随系统，或为当前会话选择浅色、深色。" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="应用主题"
                                SelectionChanged="ThemeComboBox_SelectionChanged"
                                SelectedIndex="0">
                                <ComboBoxItem Content="跟随系统" Tag="default" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="16,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="72" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="窗口材质" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="优先桌面亚克力；节能时回退云母，高对比或不支持时使用纯色。" />
                            </StackPanel>
                            <TextBlock
                                x:Name="BackdropValueText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="系统自适应" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="运行组件" />
                <Border
                    Style="{StaticResource AppGroupedSurfaceStyle}">
                    <StackPanel>
                        <Grid MinHeight="72" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="simulatorctl" />
                                <TextBlock
                                    x:Name="SimulatorCtlStateText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="正在检查…" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SimulatorCtlPathText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource AppInlineCodeTextStyle}"
                                ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="16,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="76" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Android 运行方式" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="完整系统由 QEMU 承载" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="仅后台运行，不显示或嵌入 Android 整机窗口"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="16,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="84" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="独立应用窗口" />
                                <TextBlock
                                    x:Name="ScrcpyStateText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="正在检查…" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="窗口直接呈现真实 Android 应用界面；每个应用使用自己的 scrcpy 虚拟显示，可多窗口并存" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ScrcpyPathText"
                                    Style="{StaticResource AppInlineCodeTextStyle}"
                                    ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="16,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="84" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="快捷启动协议" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="桌面快捷方式使用的启动参数" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Style="{StaticResource AppInlineCodeTextStyle}" Text="--package &lt;id&gt; --app-name &lt;name&gt; --background" />
                                <TextBlock Style="{StaticResource AppInlineCodeTextStyle}" Text="--apk &lt;path&gt; --background" />
                            </StackPanel>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="16,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid MinHeight="80" Padding="16,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="APK 双击安装" />
                                <TextBlock
                                    x:Name="ApkAssociationStateText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="正在检查…" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="双击 .apk 后后台安装、创建桌面快捷方式并打开独立应用窗口"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    x:Name="AssociationProgressRing"
                                    Width="18"
                                    Height="18"
                                    AutomationProperties.Name="正在检查 APK 文件关联"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="RepairApkAssociationButton"
                                    AutomationProperties.Name="修复 APK 文件关联"
                                    Click="RepairApkAssociationButton_Click"
                                    Content="修复关联" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar
                x:Name="AssociationInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="键位映射仅在受信任的独立应用窗口位于前台且虚拟显示 ID 可确认时发送；缺少元数据时不会吞键，也不会误发 Android 主显示。系统动画关闭后页面切换动画也会停用。"
                Severity="Informational"
                Title="行为说明" />
        </StackPanel>
    </ScrollViewer>
</Page>
