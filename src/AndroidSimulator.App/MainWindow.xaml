<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AndroidSimulator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Android Simulator"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,144,0"
            Background="Transparent">
            <StackPanel
                x:Name="TitleBarDragRegion"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontSize="16"
                    Glyph="&#xE770;"
                    IsHitTestVisible="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="Android Simulator" />
            </StackPanel>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Navigated="ContentFrame_Navigated" />

        <Grid
            x:Name="DirectLaunchStatusPanel"
            Grid.RowSpan="2"
            Background="Transparent"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="DirectLaunchTitleBar"
                Padding="16,0,144,0"
                Background="Transparent" />

            <StackPanel
                Grid.Row="1"
                MaxWidth="600"
                Margin="28,8,28,28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="10">
                <TextBlock
                    x:Name="DirectLaunchTitle"
                    FontFamily="{StaticResource AppDisplayFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="正在打开 Android 应用"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="DirectLaunchMessage"
                    Style="{StaticResource AppPageSubtitleStyle}"
                    Text="正在连接后台 Android 并创建独立应用窗口…"
                    TextTrimming="CharacterEllipsis" />
                <InfoBar
                    x:Name="DirectLaunchInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
                <Button
                    x:Name="DirectLaunchBackButton"
                    HorizontalAlignment="Left"
                    Click="DirectLaunchBackButton_Click"
                    Content="返回应用库"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="AppHostShell"
            Grid.RowSpan="2"
            Background="Transparent"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="AppHostTitleBar"
                Background="Transparent">
                <Border
                    x:Name="AppHostTitleBarTint"
                    Background="Transparent"
                    IsHitTestVisible="False" />

                <Grid
                    Padding="8,0,144,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Image
                                x:Name="AppHostIconImage"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <FontIcon
                                x:Name="AppHostFallbackIcon"
                                FontSize="12"
                                Glyph="&#xE8A5;" />
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="AppHostTitleBarDragRegion"
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Background="Transparent">
                        <TextBlock
                            x:Name="AppHostTitleText"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppDisplayFontFamily}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            IsHitTestVisible="False"
                            Text="Android 应用"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="0">
                <Border
                    x:Name="AppHostViewport"
                    Background="Transparent"
                    SizeChanged="AppHostViewport_SizeChanged" />
                <InfoBar
                    x:Name="AppHostInfoBar"
                    Margin="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Warning" />
            </Grid>
        </Grid>
    </Grid>
</Window>
